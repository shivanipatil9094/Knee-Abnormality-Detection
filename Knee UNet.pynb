{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyPFb/7ZiETJf4cfSeheByXT"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","source":["import os\n","import shutil\n","import subprocess\n","import gc\n","from pathlib import Path\n","import numpy as np\n","import torch\n","\n","print(\"=\" * 75)\n","print(\"[STEP 1/5] DOWNLOADING & STRUCTURING STANFORD MRNet-v1.0\")\n","print(\"=\" * 75)\n","\n","# Verify clean GPU state\n","gc.collect()\n","if torch.cuda.is_available():\n","    torch.cuda.empty_cache()\n","    free_gb = torch.cuda.mem_get_info()[0] / (1024**3)\n","    total_gb = torch.cuda.mem_get_info()[1] / (1024**3)\n","    print(f\"✓ GPU: {torch.cuda.get_device_name(0)} | Free VRAM: {free_gb:.2f} GB / {total_gb:.2f} GB\")\n","    if free_gb < 10.0:\n","        print(\"⚠️ WARNING: Lingering memory detected! Click 'Runtime' -> 'Restart session' first!\")\n","\n","# Setup Kaggle authentication if uploaded in /content\n","if Path(\"/content/kaggle.json\").exists():\n","    Path(\"/root/.kaggle\").mkdir(parents=True, exist_ok=True)\n","    shutil.copy(\"/content/kaggle.json\", \"/root/.kaggle/kaggle.json\")\n","    os.chmod(\"/root/.kaggle/kaggle.json\", 0o600)\n","\n","KAGGLE_SLUG = \"cjinny/mrnet-v1\"\n","download_dir = Path(\"/content/mrnet_download\")\n","raw_dir = Path(\"/content/mrnet_raw\")\n","target_mrnet_dir = raw_dir / \"MRNet-v1.0\"\n","\n","if not (target_mrnet_dir / \"train-acl.csv\").exists():\n","    if download_dir.exists():\n","        shutil.rmtree(download_dir)\n","    download_dir.mkdir(parents=True, exist_ok=True)\n","\n","    print(f\"⬇️ Downloading '{KAGGLE_SLUG}' (~6.1 GB) to {download_dir} ...\")\n","    subprocess.run([\n","        \"kaggle\", \"datasets\", \"download\",\n","        \"-d\", KAGGLE_SLUG,\n","        \"-p\", str(download_dir),\n","        \"--unzip\"\n","    ], check=True)\n","    print(\"✓ Download and unzipping complete.\")\n","\n","    found_acl = list(download_dir.rglob(\"train-acl.csv\"))\n","    if not found_acl:\n","        raise FileNotFoundError(\"✗ Could not find train-acl.csv in downloaded files.\")\n","\n","    source_root = found_acl[0].parent\n","    if target_mrnet_dir.exists():\n","        shutil.rmtree(target_mrnet_dir)\n","    target_mrnet_dir.mkdir(parents=True, exist_ok=True)\n","\n","    for item in source_root.iterdir():\n","        dest = target_mrnet_dir / item.name\n","        if item == target_mrnet_dir:\n","            continue\n","        if dest.exists():\n","            if dest.is_dir():\n","                shutil.rmtree(dest)\n","            else:\n","                dest.unlink()\n","        shutil.move(str(item), str(dest))\n","    print(f\"✓ Files organized into {target_mrnet_dir}\")\n","else:\n","    print(f\"✓ Found existing structured dataset at {target_mrnet_dir}\")\n","\n","required_paths = [\n","    target_mrnet_dir / \"train-acl.csv\",\n","    target_mrnet_dir / \"train-meniscus.csv\",\n","    target_mrnet_dir / \"train-abnormal.csv\",\n","    target_mrnet_dir / \"train\" / \"sagittal\"\n","]\n","\n","for p in required_paths:\n","    assert p.exists(), f\"Missing required path: {p}\"\n","    print(f\"[✓] {p}\")\n","\n","sagittal_dir = target_mrnet_dir / \"train\" / \"sagittal\"\n","npy_files = list(sagittal_dir.glob(\"*.npy\"))\n","num_sagittal = len(npy_files)\n","sample_tensor = np.load(npy_files[0])\n","\n","print(\"\\n\" + \"=\" * 75)\n","print(f\"🎯 STEP 1 COMPLETE: {num_sagittal} training scans validated.\")\n","print(f\"✓ Sample file: {npy_files[0].name} | Shape: {sample_tensor.shape} | Dtype: {sample_tensor.dtype}\")\n","print(\"=\" * 75)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"E1OleBi_IvGq","executionInfo":{"status":"ok","timestamp":1793370997676,"user_tz":-330,"elapsed":2689,"user":{"displayName":"Shivani Patil","userId":"15851103131718099257"}},"outputId":"4d0d69e1-6a03-4eb3-df23-937623716e01"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["===========================================================================\n","[STEP 1/5] DOWNLOADING & STRUCTURING STANFORD MRNet-v1.0\n","===========================================================================\n","✓ GPU: Tesla T4 | Free VRAM: 14.46 GB / 14.56 GB\n","✓ Found existing structured dataset at /content/mrnet_raw/MRNet-v1.0\n","[✓] /content/mrnet_raw/MRNet-v1.0/train-acl.csv\n","[✓] /content/mrnet_raw/MRNet-v1.0/train-meniscus.csv\n","[✓] /content/mrnet_raw/MRNet-v1.0/train-abnormal.csv\n","[✓] /content/mrnet_raw/MRNet-v1.0/train/sagittal\n","\n","===========================================================================\n","🎯 STEP 1 COMPLETE: 1130 training scans validated.\n","✓ Sample file: 1067.npy | Shape: (40, 256, 256) | Dtype: uint8\n","===========================================================================\n"]}]},{"cell_type":"code","source":["import os\n","import torch\n","from torch.utils.data import Dataset, DataLoader, Subset\n","import torchvision.transforms.functional as TF\n","import pandas as pd\n","import numpy as np\n","from pathlib import Path\n","from typing import Dict, Tuple, List\n","\n","SEED = 42\n","torch.manual_seed(SEED)\n","np.random.seed(SEED)\n","\n","print(\"=\" * 75)\n","print(\"[STEP 2/5] MULTI-TASK DATA PIPELINE & FEDERATED CLIENT PARTITIONING\")\n","print(\"=\" * 75)\n","\n","DATA_ROOT = Path(\"/content/mrnet_raw/MRNet-v1.0\")\n","\n","def build_master_dataframe(split: str) -> pd.DataFrame:\n","    tasks = [\"abnormal\", \"acl\", \"meniscus\"]\n","    dfs = []\n","    for task in tasks:\n","        csv_path = DATA_ROOT / f\"{split}-{task}.csv\"\n","        if not csv_path.exists():\n","            raise FileNotFoundError(f\"Missing required label CSV: {csv_path}\")\n","        df_task = pd.read_csv(csv_path, header=None, names=[\"case_id\", task], dtype={0: int, 1: int})\n","        df_task[\"case_id\"] = df_task[\"case_id\"].apply(lambda x: f\"{x:04d}\")\n","        dfs.append(df_task)\n","\n","    master_df = dfs[0]\n","    for df in dfs[1:]:\n","        master_df = master_df.merge(df, on=\"case_id\", how=\"inner\")\n","\n","    master_df[\"sagittal_path\"] = master_df[\"case_id\"].apply(\n","        lambda cid: str(DATA_ROOT / split / \"sagittal\" / f\"{cid}.npy\")\n","    )\n","    valid_mask = master_df[\"sagittal_path\"].apply(os.path.exists)\n","    if not valid_mask.all():\n","        master_df = master_df[valid_mask].reset_index(drop=True)\n","    return master_df\n","\n","train_df = build_master_dataframe(\"train\")\n","valid_df = build_master_dataframe(\"valid\")\n","\n","print(f\"✓ Master Train Cohort : {len(train_df)} cases\")\n","print(f\"✓ Master Valid Cohort : {len(valid_df)} cases\")\n","\n","class FastMRNetDataset(Dataset):\n","    def __init__(self, df: pd.DataFrame, is_train: bool = True):\n","        self.df = df.reset_index(drop=True)\n","        self.is_train = is_train\n","        self.mean = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)\n","        self.std = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)\n","\n","    def __len__(self) -> int:\n","        return len(self.df)\n","\n","    def __getitem__(self, idx: int) -> Tuple[torch.Tensor, torch.Tensor, str]:\n","        row = self.df.iloc[idx]\n","        volume = np.load(row[\"sagittal_path\"])\n","\n","        # (S, 3, H, W)\n","        tensor = torch.from_numpy(volume).float() / 255.0\n","        tensor = tensor.unsqueeze(1).repeat(1, 3, 1, 1)\n","\n","        if self.is_train:\n","            if torch.rand(1).item() > 0.5:\n","                tensor = torch.flip(tensor, dims=[-1])\n","            if torch.rand(1).item() > 0.5:\n","                angle = float(torch.empty(1).uniform_(-10, 10).item())\n","                tensor = TF.rotate(tensor, angle)\n","\n","        tensor = (tensor - self.mean) / self.std\n","        labels = torch.tensor([row[\"abnormal\"], row[\"acl\"], row[\"meniscus\"]], dtype=torch.float32)\n","        return tensor, labels, row[\"case_id\"]\n","\n","train_dataset = FastMRNetDataset(train_df, is_train=True)\n","valid_dataset = FastMRNetDataset(valid_df, is_train=False)\n","\n","val_loader = DataLoader(valid_dataset, batch_size=1, shuffle=False, num_workers=2, pin_memory=True)\n","\n","HOSPITAL_NAMES = [\"Hospital_1_SportsClinic\", \"Hospital_2_GeneralOrtho\", \"Hospital_3_RegionalCenter\"]\n","NUM_CLIENTS = len(HOSPITAL_NAMES)\n","\n","def partition_moderate_non_iid(df: pd.DataFrame) -> Dict[str, List[int]]:\n","    acl_idx = df[df[\"acl\"] == 1].index.tolist()\n","    men_idx = df[(df[\"acl\"] == 0) & (df[\"meniscus\"] == 1)].index.tolist()\n","    norm_idx = df[(df[\"acl\"] == 0) & (df[\"meniscus\"] == 0)].index.tolist()\n","\n","    np.random.shuffle(acl_idx)\n","    np.random.shuffle(men_idx)\n","    np.random.shuffle(norm_idx)\n","\n","    def distribute(indices, proportions):\n","        n = len(indices)\n","        p1 = int(proportions[0] * n)\n","        p2 = int(proportions[1] * n)\n","        return indices[:p1], indices[p1:p1+p2], indices[p1+p2:]\n","\n","    a1, a2, a3 = distribute(acl_idx, [0.45, 0.30, 0.25])\n","    m1, m2, m3 = distribute(men_idx, [0.25, 0.45, 0.30])\n","    n1, n2, n3 = distribute(norm_idx, [0.30, 0.30, 0.40])\n","\n","    splits = {h: [] for h in HOSPITAL_NAMES}\n","    for h, (a, m, n) in zip(HOSPITAL_NAMES, [(a1, m1, n1), (a2, m2, n2), (a3, m3, n3)]):\n","        splits[h] = a + m + n\n","        np.random.shuffle(splits[h])\n","    return splits\n","\n","client_indices = partition_moderate_non_iid(train_df)\n","client_loaders: Dict[str, DataLoader] = {\n","    h: DataLoader(Subset(train_dataset, idxs), batch_size=1, shuffle=True, num_workers=2, pin_memory=True)\n","    for h, idxs in client_indices.items()\n","}\n","\n","print(\"✓ Hospital Partitioning Summary:\")\n","stats_summary = []\n","for h_name, idxs in client_indices.items():\n","    sub_df = train_df.iloc[idxs]\n","    stats_summary.append({\n","        \"Client\": h_name,\n","        \"Exams\": len(idxs),\n","        \"Abnormal\": f\"{sub_df['abnormal'].mean() * 100:.1f}%\",\n","        \"ACL Tear\": f\"{sub_df['acl'].mean() * 100:.1f}%\",\n","        \"Meniscus Tear\": f\"{sub_df['meniscus'].mean() * 100:.1f}%\"\n","    })\n","print(pd.DataFrame(stats_summary).to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"U2_79Hm9Lvuo","executionInfo":{"status":"ok","timestamp":1793371010412,"user_tz":-330,"elapsed":1983,"user":{"displayName":"Shivani Patil","userId":"15851103131718099257"}},"outputId":"0e6eba63-c927-4a1d-effd-1d47988152ed"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["===========================================================================\n","[STEP 2/5] MULTI-TASK DATA PIPELINE & FEDERATED CLIENT PARTITIONING\n","===========================================================================\n","✓ Master Train Cohort : 1130 cases\n","✓ Master Valid Cohort : 120 cases\n","✓ Hospital Partitioning Summary:\n","                   Client  Exams Abnormal ACL Tear Meniscus Tear\n","  Hospital_1_SportsClinic    356    81.7%    26.1%         38.2%\n","  Hospital_2_GeneralOrtho    379    83.1%    16.4%         40.4%\n","Hospital_3_RegionalCenter    395    77.7%    13.4%         27.3%\n"]}]},{"cell_type":"code","source":["import os\n","import gc\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","os.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n","\n","print(\"=\" * 75)\n","print(\"[STEP 3/5] ULTRA-EFFICIENT U-NET ARCHITECTURE (PEAK VRAM < 150 MB)\")\n","print(\"=\" * 75)\n","\n","class DoubleConv(nn.Module):\n","    \"\"\"(Conv2D -> BatchNorm -> ReLU) * 2\"\"\"\n","    def __init__(self, in_channels: int, out_channels: int):\n","        super().__init__()\n","        self.double_conv = nn.Sequential(\n","            nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1, bias=False),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","            nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1, bias=False),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True)\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        return self.double_conv(x)\n","\n","\n","class Down(nn.Module):\n","    \"\"\"Downscaling with MaxPool2D(2) then DoubleConv\"\"\"\n","    def __init__(self, in_channels: int, out_channels: int):\n","        super().__init__()\n","        self.maxpool_conv = nn.Sequential(\n","            nn.MaxPool2d(2),\n","            DoubleConv(in_channels, out_channels)\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        return self.maxpool_conv(x)\n","\n","\n","class Up(nn.Module):\n","    \"\"\"Upscaling via ConvTranspose2D followed by concatenation and DoubleConv\"\"\"\n","    def __init__(self, in_channels: int, out_channels: int):\n","        super().__init__()\n","        self.up = nn.ConvTranspose2d(in_channels, out_channels, kernel_size=2, stride=2)\n","        self.conv = DoubleConv(out_channels * 2, out_channels)\n","\n","    def forward(self, x1: torch.Tensor, x2: torch.Tensor) -> torch.Tensor:\n","        x1 = self.up(x1)\n","        diff_y = x2.size(2) - x1.size(2)\n","        diff_x = x2.size(3) - x1.size(3)\n","        if diff_x > 0 or diff_y > 0:\n","            x1 = F.pad(x1, [diff_x // 2, diff_x - diff_x // 2,\n","                           diff_y // 2, diff_y - diff_y // 2])\n","        x = torch.cat([x2, x1], dim=1)\n","        return self.conv(x)\n","\n","\n","class UNetFeatureExtractor(nn.Module):\n","    def __init__(self, in_channels: int = 3, base_channels: int = 16, feature_dim: int = 512):\n","        super().__init__()\n","        # Encoder (Contracting Path)\n","        self.inc = DoubleConv(in_channels, base_channels)          # 3 -> 16\n","        self.down1 = Down(base_channels, base_channels * 2)       # 16 -> 32\n","        self.down2 = Down(base_channels * 2, base_channels * 4)   # 32 -> 64\n","        self.down3 = Down(base_channels * 4, base_channels * 8)   # 64 -> 128\n","        self.down4 = Down(base_channels * 8, base_channels * 16)  # 128 -> 256 (Bottleneck)\n","\n","        # Decoder (Expansive Path with Skip Connections)\n","        self.up1 = Up(base_channels * 16, base_channels * 8)      # 256 -> 128\n","        self.up2 = Up(base_channels * 8, base_channels * 4)       # 128 -> 64\n","        self.up3 = Up(base_channels * 4, base_channels * 2)       # 64 -> 32\n","        self.up4 = Up(base_channels * 2, base_channels)           # 32 -> 16\n","\n","        # Multi-scale pooling\n","        self.pool = nn.AdaptiveAvgPool2d((1, 1))\n","\n","        # Project fused multi-scale features: Bottleneck (256) + Decoder (16) = 272 -> 512\n","        fused_dim = (base_channels * 16) + base_channels\n","        self.fc_proj = nn.Sequential(\n","            nn.Linear(fused_dim, feature_dim),\n","            nn.LayerNorm(feature_dim),   # Completely immune to batch size = 1\n","            nn.ReLU(inplace=True)\n","        )\n","\n","    def _forward_chunk(self, x_chunk: torch.Tensor) -> torch.Tensor:\n","        x1 = self.inc(x_chunk)\n","        x2 = self.down1(x1)\n","        x3 = self.down2(x2)\n","        x4 = self.down3(x3)\n","        x5 = self.down4(x4)\n","\n","        d1 = self.up1(x5, x4)\n","        d2 = self.up2(d1, x3)\n","        d3 = self.up3(d2, x2)\n","        d4 = self.up4(d3, x1)\n","\n","        p_bottleneck = self.pool(x5).flatten(1)  # (C_slices, 256)\n","        p_decoder = self.pool(d4).flatten(1)     # (C_slices, 16)\n","\n","        fused = torch.cat([p_bottleneck, p_decoder], dim=1)  # (C_slices, 272)\n","        return self.fc_proj(fused)                           # (C_slices, 512)\n","\n","    def forward(self, x: torch.Tensor, chunk_size: int = 4) -> torch.Tensor:\n","        num_slices = x.size(0)\n","        if num_slices <= chunk_size:\n","            return self._forward_chunk(x)\n","\n","        # Smart micro-chunking: handles odd slice counts safely\n","        feats = []\n","        i = 0\n","        while i < num_slices:\n","            remaining = num_slices - i\n","            if remaining == chunk_size + 1:\n","                cur_chunk = remaining\n","            else:\n","                cur_chunk = min(chunk_size, remaining)\n","            feats.append(self._forward_chunk(x[i : i + cur_chunk]))\n","            i += cur_chunk\n","        return torch.cat(feats, dim=0)\n","\n","\n","class UNetMRNetModel(nn.Module):\n","    def __init__(self, num_classes: int = 3, dropout_rate: float = 0.5, base_channels: int = 16, feature_dim: int = 512):\n","        super(UNetMRNetModel, self).__init__()\n","        self.feature_extractor = UNetFeatureExtractor(\n","            in_channels=3,\n","            base_channels=base_channels,\n","            feature_dim=feature_dim\n","        )\n","        self.classifier = nn.Sequential(\n","            nn.Dropout(p=dropout_rate),\n","            nn.Linear(feature_dim, num_classes)\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        if x.dim() == 5:\n","            x = x.squeeze(0)\n","        slice_features = self.feature_extractor(x)                            # (Slices, 512)\n","        patient_feature, _ = torch.max(slice_features, dim=0, keepdim=True)    # (1, 512)\n","        return self.classifier(patient_feature)                              # (1, 3)\n","\n","MRNetModel = UNetMRNetModel\n","\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","\n","# Loss with clamped class weights\n","pos_counts = train_df[[\"abnormal\", \"acl\", \"meniscus\"]].sum().values\n","neg_counts = len(train_df) - pos_counts\n","raw_pos_weights = torch.tensor(neg_counts / pos_counts, dtype=torch.float32).to(device)\n","clamped_pos_weights = torch.clamp(raw_pos_weights, min=1.0)\n","criterion = nn.BCEWithLogitsLoss(pos_weight=clamped_pos_weights)\n","\n","model = UNetMRNetModel(num_classes=3).to(device)\n","total_params = sum(p.numel() for p in model.parameters())\n","print(f\"✓ Model Initialized: {total_params:,} parameters on {device}\")\n","\n","# Sanity Check with Mixed Precision\n","sample_vol, sample_label, _ = next(iter(client_loaders[\"Hospital_1_SportsClinic\"]))\n","sample_vol, sample_label = sample_vol.to(device), sample_label.to(device)\n","\n","model.train()\n","optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4)\n","optimizer.zero_grad()\n","\n","with torch.amp.autocast('cuda', enabled=(device.type == 'cuda')):\n","    logits = model(sample_vol)\n","    loss = criterion(logits, sample_label)\n","\n","loss.backward()\n","optimizer.step()\n","\n","allocated_mb = torch.cuda.memory_allocated() / (1024**2) if torch.cuda.is_available() else 0\n","print(f\"✓ Sanity Check Passed!\")\n","print(f\"  • Logits shape  : {tuple(logits.shape)}\")\n","print(f\"  • BCE Loss      : {loss.item():.4f}\")\n","print(f\"  • Current VRAM  : {allocated_mb:.1f} MB (Extremely low!)\")\n","\n","# Clean memory after sanity check\n","del sample_vol, sample_label, logits, loss, model, optimizer\n","gc.collect()\n","if torch.cuda.is_available():\n","    torch.cuda.empty_cache()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8no8GxVHO27k","executionInfo":{"status":"ok","timestamp":1793371027283,"user_tz":-330,"elapsed":1823,"user":{"displayName":"Shivani Patil","userId":"15851103131718099257"}},"outputId":"1d6b3003-d405-4923-81e2-71c782940ca3"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["===========================================================================\n","[STEP 3/5] ULTRA-EFFICIENT U-NET ARCHITECTURE (PEAK VRAM < 150 MB)\n","===========================================================================\n","✓ Model Initialized: 2,084,899 parameters on cuda\n","✓ Sanity Check Passed!\n","  • Logits shape  : (1, 3)\n","  • BCE Loss      : 0.5362\n","  • Current VRAM  : 67.4 MB (Extremely low!)\n"]}]},{"cell_type":"code","source":["import copy\n","import gc\n","import numpy as np\n","from sklearn.metrics import roc_auc_score\n","\n","def train_fedprox_client(\n","    model: nn.Module,\n","    global_model: nn.Module,\n","    dataloader: DataLoader,\n","    criterion: nn.Module,\n","    device: torch.device,\n","    lr_backbone: float,\n","    lr_head: float,\n","    max_steps: int,\n","    mu: float = 0.01,\n","    use_amp: bool = True\n",") -> Tuple[Dict[str, torch.Tensor], float]:\n","    model.train()\n","\n","    # Freeze BatchNorm running stats to prevent noisy slice divergence (From Page 9 of PDF)\n","    for m in model.modules():\n","        if isinstance(m, (nn.BatchNorm2d, nn.BatchNorm1d)):\n","            m.eval()\n","\n","    optimizer = torch.optim.AdamW([\n","        {\"params\": model.feature_extractor.parameters(), \"lr\": lr_backbone},\n","        {\"params\": model.classifier.parameters(), \"lr\": lr_head}\n","    ], weight_decay=1e-3)\n","\n","    scaler = torch.amp.GradScaler('cuda', enabled=(use_amp and device.type == 'cuda'))\n","    global_params = [p.detach().clone() for p in global_model.parameters()]\n","\n","    running_loss, steps = 0.0, 0\n","    for volume, labels, _ in dataloader:\n","        if steps >= max_steps:\n","            break\n","        volume = volume.squeeze(0).to(device)\n","        labels = labels.to(device)\n","\n","        optimizer.zero_grad()\n","        with torch.amp.autocast('cuda', enabled=(use_amp and device.type == 'cuda')):\n","            logits = model(volume)\n","            task_loss = criterion(logits, labels)\n","\n","            prox_term = 0.0\n","            if mu > 0:\n","                for p, p_glob in zip(model.parameters(), global_params):\n","                    prox_term += (p - p_glob).pow(2).sum()\n","\n","            loss = task_loss + (mu / 2.0) * prox_term\n","\n","        scaler.scale(loss).backward()\n","        scaler.unscale_(optimizer)\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n","        scaler.step(optimizer)\n","        scaler.update()\n","\n","        running_loss += task_loss.item()\n","        steps += 1\n","\n","    avg_loss = running_loss / max(1, steps)\n","    local_weights = {k: v.cpu().clone() for k, v in model.state_dict().items()}\n","    return local_weights, avg_loss\n","\n","\n","@torch.no_grad()\n","def evaluate_global(model: nn.Module, val_loader: DataLoader, criterion: nn.Module, device: torch.device):\n","    model.eval()\n","    total_val_loss = 0.0\n","    all_preds, all_targets = [], []\n","\n","    with torch.amp.autocast('cuda', enabled=(device.type == 'cuda')):\n","        for volume, labels, _ in val_loader:\n","            volume = volume.squeeze(0).to(device)\n","            labels = labels.to(device)\n","            logits = model(volume)\n","            loss = criterion(logits, labels)\n","            total_val_loss += loss.item()\n","            all_preds.append(torch.sigmoid(logits).cpu().numpy()[0])\n","            all_targets.append(labels.cpu().numpy()[0])\n","\n","    val_loss = total_val_loss / len(val_loader)\n","    all_preds = np.array(all_preds)\n","    all_targets = np.array(all_targets)\n","\n","    task_aucs = {}\n","    for i, task in enumerate([\"Abnormal\", \"ACL\", \"Meniscus\"]):\n","        try:\n","            task_aucs[task] = roc_auc_score(all_targets[:, i], all_preds[:, i])\n","        except ValueError:\n","            task_aucs[task] = 0.50\n","\n","    mean_auc = float(np.mean(list(task_aucs.values())))\n","    return val_loss, mean_auc, task_aucs\n","\n","\n","def federated_averaging(client_state_dicts: List[Dict[str, torch.Tensor]], client_sample_counts: List[int]) -> Dict[str, torch.Tensor]:\n","    total = sum(client_sample_counts)\n","    weights = [n / total for n in client_sample_counts]\n","    global_sd = copy.deepcopy(client_state_dicts[0])\n","\n","    for k in global_sd.keys():\n","        global_sd[k] = client_state_dicts[0][k].float() * weights[0]\n","        for i in range(1, len(client_state_dicts)):\n","            global_sd[k] += client_state_dicts[i][k].float() * weights[i]\n","        global_sd[k] = global_sd[k].to(client_state_dicts[0][k].dtype)\n","    return global_sd\n","\n","print(\"✓ Federated routines (train_fedprox_client, evaluate_global, federated_averaging) ready.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oxKaTqjDO6cE","executionInfo":{"status":"ok","timestamp":1793371044894,"user_tz":-330,"elapsed":2263,"user":{"displayName":"Shivani Patil","userId":"15851103131718099257"}},"outputId":"6c041e7e-cf91-43f2-baab-06d996dd9167"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["✓ Federated routines (train_fedprox_client, evaluate_global, federated_averaging) ready.\n"]}]},{"cell_type":"code","source":["import time\n","import gc\n","\n","print(\"=\" * 80)\n","print(\"[STEP 5/5] LAUNCHING HIGH-PERFORMANCE FEDPROX TRAINING WITH U-NET\")\n","print(\"=\" * 80)\n","\n","NUM_ROUNDS = 15\n","LOCAL_STEPS = 80\n","LR_BACKBONE = 1e-4\n","LR_CLASSIFIER = 5e-4\n","FEDPROX_MU = 0.01\n","\n","global_model = UNetMRNetModel(num_classes=3).to(device)\n","hospital_names = list(client_loaders.keys())\n","sample_counts = [len(client_loaders[h].dataset) for h in hospital_names]\n","\n","federated_history = {\n","    \"round\": [],\n","    \"client_losses\": {h: [] for h in hospital_names},\n","    \"val_loss\": [],\n","    \"mean_val_auc\": [],\n","    \"task_aucs\": {t: [] for t in [\"Abnormal\", \"ACL\", \"Meniscus\"]}\n","}\n","\n","best_val_auc = 0.0\n","start_time = time.time()\n","\n","print(f\"🚀 Training on {device}...\")\n","print(f\"• Total Rounds     : {NUM_ROUNDS}\")\n","print(f\"• Local Steps/Rnd  : {LOCAL_STEPS} scans per hospital\")\n","print(f\"• LR Backbone/Head : {LR_BACKBONE} / {LR_CLASSIFIER}\")\n","print(f\"• FedProx Mu       : {FEDPROX_MU}\\n\")\n","\n","for rnd in range(1, NUM_ROUNDS + 1):\n","    r_start = time.time()\n","    client_sds = []\n","\n","    # 1. Local Hospital Training\n","    for h_name in hospital_names:\n","        client_model = UNetMRNetModel(num_classes=3).to(device)\n","        client_model.load_state_dict(global_model.state_dict())\n","\n","        local_weights, local_loss = train_fedprox_client(\n","            model=client_model,\n","            global_model=global_model,\n","            dataloader=client_loaders[h_name],\n","            criterion=criterion,\n","            device=device,\n","            lr_backbone=LR_BACKBONE,\n","            lr_head=LR_CLASSIFIER,\n","            max_steps=LOCAL_STEPS,\n","            mu=FEDPROX_MU\n","        )\n","        client_sds.append(local_weights)\n","        federated_history[\"client_losses\"][h_name].append(local_loss)\n","\n","        del client_model\n","        if torch.cuda.is_available():\n","            torch.cuda.empty_cache()\n","\n","    # 2. Federated Aggregation\n","    agg_weights = federated_averaging(client_sds, sample_counts)\n","    global_model.load_state_dict({k: v.to(device) for k, v in agg_weights.items()})\n","    del client_sds\n","\n","    # 3. Global Validation\n","    val_loss, mean_auc, task_aucs = evaluate_global(global_model, val_loader, criterion, device)\n","\n","    federated_history[\"round\"].append(rnd)\n","    federated_history[\"val_loss\"].append(val_loss)\n","    federated_history[\"mean_val_auc\"].append(mean_auc)\n","    for t in [\"Abnormal\", \"ACL\", \"Meniscus\"]:\n","        federated_history[\"task_aucs\"][t].append(task_aucs[t])\n","\n","    r_time = time.time() - r_start\n","    print(f\"Round {rnd:02d}/{NUM_ROUNDS} ({r_time:.1f}s) | Val Loss: {val_loss:.4f} | Mean ROC-AUC: {mean_auc:.4f}\")\n","    print(f\"   └── Abnormal: {task_aucs['Abnormal']:.3f} | ACL: {task_aucs['ACL']:.3f} | Meniscus: {task_aucs['Meniscus']:.3f}\")\n","\n","    if rnd % 5 == 0:\n","        LR_BACKBONE *= 0.8\n","        LR_CLASSIFIER *= 0.8\n","\n","    if mean_auc > best_val_auc:\n","        best_val_auc = mean_auc\n","        torch.save(global_model.state_dict(), \"/content/best_federated_mrnet.pth\")\n","        print(\"   🌟 Best Checkpoint Saved!\")\n","\n","    gc.collect()\n","    if torch.cuda.is_available():\n","        torch.cuda.empty_cache()\n","\n","total_mins = (time.time() - start_time) / 60\n","print(\"\\n\" + \"=\" * 80)\n","print(f\"🎯 FEDPROX TRAINING FINISHED IN {total_mins:.2f} mins!\")\n","print(f\"✓ Peak Global Mean ROC-AUC: {best_val_auc:.4f}\")\n","print(f\"✓ Model Checkpoint        : /content/best_federated_mrnet.pth\")\n","print(\"=\" * 80)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zrCVvUOBPoro","executionInfo":{"status":"ok","timestamp":1793371933335,"user_tz":-330,"elapsed":873003,"user":{"displayName":"Shivani Patil","userId":"15851103131718099257"}},"outputId":"c189eb4e-d169-4004-f17d-f8a6ef1c4bc4"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["================================================================================\n","[STEP 5/5] LAUNCHING HIGH-PERFORMANCE FEDPROX TRAINING WITH U-NET\n","================================================================================\n","🚀 Training on cuda...\n","• Total Rounds     : 15\n","• Local Steps/Rnd  : 80 scans per hospital\n","• LR Backbone/Head : 0.0001 / 0.0005\n","• FedProx Mu       : 0.01\n","\n","Round 01/15 (59.6s) | Val Loss: 2.3243 | Mean ROC-AUC: 0.4877\n","   └── Abnormal: 0.260 | ACL: 0.583 | Meniscus: 0.620\n","   🌟 Best Checkpoint Saved!\n","Round 02/15 (57.9s) | Val Loss: 3.2971 | Mean ROC-AUC: 0.4808\n","   └── Abnormal: 0.579 | ACL: 0.387 | Meniscus: 0.476\n","Round 03/15 (57.7s) | Val Loss: 3.0796 | Mean ROC-AUC: 0.5126\n","   └── Abnormal: 0.646 | ACL: 0.429 | Meniscus: 0.462\n","   🌟 Best Checkpoint Saved!\n","Round 04/15 (58.7s) | Val Loss: 3.0383 | Mean ROC-AUC: 0.4637\n","   └── Abnormal: 0.284 | ACL: 0.510 | Meniscus: 0.597\n","Round 05/15 (57.7s) | Val Loss: 2.3861 | Mean ROC-AUC: 0.4964\n","   └── Abnormal: 0.383 | ACL: 0.570 | Meniscus: 0.536\n","Round 06/15 (58.4s) | Val Loss: 2.6468 | Mean ROC-AUC: 0.5254\n","   └── Abnormal: 0.499 | ACL: 0.566 | Meniscus: 0.511\n","   🌟 Best Checkpoint Saved!\n","Round 07/15 (57.7s) | Val Loss: 2.9978 | Mean ROC-AUC: 0.5344\n","   └── Abnormal: 0.572 | ACL: 0.549 | Meniscus: 0.482\n","   🌟 Best Checkpoint Saved!\n","Round 08/15 (57.7s) | Val Loss: 3.3024 | Mean ROC-AUC: 0.5351\n","   └── Abnormal: 0.567 | ACL: 0.562 | Meniscus: 0.476\n","   🌟 Best Checkpoint Saved!\n","Round 09/15 (58.4s) | Val Loss: 3.4020 | Mean ROC-AUC: 0.5436\n","   └── Abnormal: 0.635 | ACL: 0.570 | Meniscus: 0.426\n","   🌟 Best Checkpoint Saved!\n","Round 10/15 (56.7s) | Val Loss: 3.1228 | Mean ROC-AUC: 0.5444\n","   └── Abnormal: 0.636 | ACL: 0.571 | Meniscus: 0.426\n","   🌟 Best Checkpoint Saved!\n","Round 11/15 (57.0s) | Val Loss: 3.4090 | Mean ROC-AUC: 0.5602\n","   └── Abnormal: 0.652 | ACL: 0.557 | Meniscus: 0.471\n","   🌟 Best Checkpoint Saved!\n","Round 12/15 (58.4s) | Val Loss: 3.5057 | Mean ROC-AUC: 0.5180\n","   └── Abnormal: 0.525 | ACL: 0.560 | Meniscus: 0.470\n","Round 13/15 (59.4s) | Val Loss: 3.1358 | Mean ROC-AUC: 0.5199\n","   └── Abnormal: 0.582 | ACL: 0.533 | Meniscus: 0.444\n","Round 14/15 (56.9s) | Val Loss: 3.0360 | Mean ROC-AUC: 0.5189\n","   └── Abnormal: 0.660 | ACL: 0.485 | Meniscus: 0.411\n","Round 15/15 (57.2s) | Val Loss: 3.1675 | Mean ROC-AUC: 0.4932\n","   └── Abnormal: 0.584 | ACL: 0.476 | Meniscus: 0.419\n","\n","================================================================================\n","🎯 FEDPROX TRAINING FINISHED IN 14.55 mins!\n","✓ Peak Global Mean ROC-AUC: 0.5602\n","✓ Model Checkpoint        : /content/best_federated_mrnet.pth\n","================================================================================\n"]}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","\n","# 1. Plot Training History\n","fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n","\n","axes[0].plot(federated_history[\"round\"], federated_history[\"val_loss\"], marker='o', color='crimson', label='Val Loss')\n","axes[0].set_title(\"Validation Loss across Communication Rounds\", fontsize=12, fontweight='bold')\n","axes[0].set_xlabel(\"Federated Round\")\n","axes[0].set_ylabel(\"Weighted BCE Loss\")\n","axes[0].grid(True, linestyle=\"--\", alpha=0.6)\n","axes[0].legend()\n","\n","axes[1].plot(federated_history[\"round\"], federated_history[\"mean_val_auc\"], marker='s', color='navy', label='Mean AUC', linewidth=2.5)\n","for t, col in zip([\"Abnormal\", \"ACL\", \"Meniscus\"], [\"coral\", \"teal\", \"mediumpurple\"]):\n","    axes[1].plot(federated_history[\"round\"], federated_history[\"task_aucs\"][t], marker='.', linestyle='--', color=col, label=f'{t} AUC')\n","axes[1].set_title(\"Multi-Task ROC-AUC (Abnormal, ACL, Meniscus)\", fontsize=12, fontweight='bold')\n","axes[1].set_xlabel(\"Federated Round\")\n","axes[1].set_ylabel(\"ROC-AUC\")\n","axes[1].grid(True, linestyle=\"--\", alpha=0.6)\n","axes[1].legend()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# 2. Single-Patient Inference Demo\n","best_model = UNetMRNetModel(num_classes=3).to(device)\n","best_model.load_state_dict(torch.load(\"/content/best_federated_mrnet.pth\"))\n","best_model.eval()\n","\n","sample_vol, sample_labels, case_id = valid_dataset[0]\n","with torch.no_grad():\n","    logits = best_model(sample_vol.to(device))\n","    probs = torch.sigmoid(logits).cpu().numpy()[0]\n","\n","print(f\"\\nInference for Validation Case: {case_id}\")\n","print(f\"  • Abnormal      : {probs[0] * 100:.1f}% (Actual: {int(sample_labels[0].item())})\")\n","print(f\"  • ACL Tear      : {probs[1] * 100:.1f}% (Actual: {int(sample_labels[1].item())})\")\n","print(f\"  • Meniscus Tear : {probs[2] * 100:.1f}% (Actual: {int(sample_labels[2].item())})\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":527},"id":"E2BeaAvLScqI","executionInfo":{"status":"ok","timestamp":1793371954989,"user_tz":-330,"elapsed":1610,"user":{"displayName":"Shivani Patil","userId":"15851103131718099257"}},"outputId":"a6de13cf-702a-498f-a85c-fb03a150f67c"},"execution_count":6,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Inference for Validation Case: 1130\n","  • Abnormal      : 94.3% (Actual: 0)\n","  • ACL Tear      : 2.6% (Actual: 0)\n","  • Meniscus Tear : 6.1% (Actual: 0)\n"]}]},{"cell_type":"code","source":["import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import torch\n","from sklearn.metrics import (\n","    accuracy_score,\n","    precision_score,\n","    recall_score,\n","    f1_score,\n","    roc_auc_score,\n","    average_precision_score,\n","    confusion_matrix,\n","    roc_curve,\n","    precision_recall_curve\n",")\n","\n","print(\"=\" * 80)\n","print(\"[EVALUATION] FULL CLINICAL DIAGNOSTIC METRICS & MULTI-PANEL PLOTS\")\n","print(\"=\" * 80)\n","\n","# 1. Load Best Saved U-Net Model\n","best_model = UNetMRNetModel(num_classes=3).to(device)\n","model_path = \"/content/best_federated_mrnet.pth\"\n","\n","if os.path.exists(model_path):\n","    best_model.load_state_dict(torch.load(model_path))\n","    print(f\"✓ Loaded best global checkpoint from: {model_path}\")\n","else:\n","    print(\"⚠️ Checkpoint not found, evaluating current global_model instance.\")\n","    best_model = global_model\n","\n","best_model.eval()\n","\n","# 2. Extract Predictions across the entire Validation Cohort\n","all_targets = []\n","all_probs = []\n","\n","with torch.no_grad():\n","    for volume, labels, _ in val_loader:\n","        volume = volume.squeeze(0).to(device)\n","        labels = labels.to(device)\n","        with torch.amp.autocast('cuda', enabled=(device.type == 'cuda')):\n","            logits = best_model(volume)\n","            probs = torch.sigmoid(logits)\n","\n","        all_probs.append(probs.cpu().numpy()[0])\n","        all_targets.append(labels.cpu().numpy()[0])\n","\n","all_targets = np.array(all_targets)  # Shape: (N, 3)\n","all_probs = np.array(all_probs)      # Shape: (N, 3)\n","all_preds = (all_probs >= 0.5).astype(int)  # Binary predictions at threshold 0.50\n","\n","task_names = [\"Abnormal\", \"ACL Tear\", \"Meniscus Tear\"]\n","\n","# 3. Calculate Clinical Metrics Table\n","metrics_list = []\n","for i, task in enumerate(task_names):\n","    y_true = all_targets[:, i]\n","    y_prob = all_probs[:, i]\n","    y_pred = all_preds[:, i]\n","\n","    tn, fp, fn, tp = confusion_matrix(y_true, y_pred, labels=[0, 1]).ravel()\n","\n","    acc = accuracy_score(y_true, y_pred)\n","    prec = precision_score(y_true, y_pred, zero_division=0)\n","    rec = recall_score(y_true, y_pred, zero_division=0)  # Sensitivity\n","    spec = tn / (tn + fp) if (tn + fp) > 0 else 0.0      # Specificity\n","    f1 = f1_score(y_true, y_pred, zero_division=0)\n","    roc_auc = roc_auc_score(y_true, y_prob)\n","    pr_auc = average_precision_score(y_true, y_prob)\n","\n","    metrics_list.append({\n","        \"Condition\": task,\n","        \"Total (Pos/Neg)\": f\"{int(tp+fn)} / {int(tn+fp)}\",\n","        \"Accuracy\": f\"{acc * 100:.2f}%\",\n","        \"Precision (PPV)\": f\"{prec * 100:.2f}%\",\n","        \"Recall (Sens.)\": f\"{rec * 100:.2f}%\",\n","        \"Specificity\": f\"{spec * 100:.2f}%\",\n","        \"F1-Score\": f\"{f1:.4f}\",\n","        \"ROC-AUC\": f\"{roc_auc:.4f}\",\n","        \"PR-AUC\": f\"{pr_auc:.4f}\"\n","    })\n","\n","metrics_df = pd.DataFrame(metrics_list)\n","print(\"\\n📋 CLINICAL PERFORMANCE SUMMARY (Validation Cohort):\")\n","print(metrics_df.to_string(index=False))\n","\n","# 4. Generate Diagnostic Plots\n","plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')\n","fig = plt.figure(figsize=(18, 14))\n","\n","# -------------------------------------------------------------\n","# PLOT 1: Confusion Matrices for All 3 Classes\n","# -------------------------------------------------------------\n","for i, task in enumerate(task_names):\n","    ax = plt.subplot(2, 3, i + 1)\n","    cm = confusion_matrix(all_targets[:, i], all_preds[:, i], labels=[0, 1])\n","\n","    # Annotations with counts and percentages\n","    cm_perc = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis] * 100\n","    labels_matrix = np.array([\n","        [f\"{cm[0,0]}\\n({cm_perc[0,0]:.1f}%)\", f\"{cm[0,1]}\\n({cm_perc[0,1]:.1f}%)\"],\n","        [f\"{cm[1,0]}\\n({cm_perc[1,0]:.1f}%)\", f\"{cm[1,1]}\\n({cm_perc[1,1]:.1f}%)\"]\n","    ])\n","\n","    sns.heatmap(cm, annot=labels_matrix, fmt='', cmap=\"Blues\", cbar=False, ax=ax,\n","                xticklabels=[\"Negative (0)\", \"Positive (1)\"],\n","                yticklabels=[\"Negative (0)\", \"Positive (1)\"],\n","                annot_kws={\"size\": 11, \"weight\": \"bold\"})\n","    ax.set_title(f\"Confusion Matrix: {task}\", fontsize=13, fontweight='bold', pad=10)\n","    ax.set_xlabel(\"Predicted Label\", fontsize=11)\n","    ax.set_ylabel(\"True Label\", fontsize=11)\n","\n","# -------------------------------------------------------------\n","# PLOT 2: Receiver Operating Characteristic (ROC) Curves\n","# -------------------------------------------------------------\n","ax_roc = plt.subplot(2, 3, 4)\n","colors = [\"#2b5c8f\", \"#d95f02\", \"#7570b3\"]\n","\n","for i, (task, color) in enumerate(zip(task_names, colors)):\n","    fpr, tpr, _ = roc_curve(all_targets[:, i], all_probs[:, i])\n","    auc_val = roc_auc_score(all_targets[:, i], all_probs[:, i])\n","    ax_roc.plot(fpr, tpr, color=color, lw=2.2, label=f\"{task} (AUC = {auc_val:.3f})\")\n","\n","ax_roc.plot([0, 1], [0, 1], color='gray', linestyle='--', lw=1.5, label=\"Random Guess (0.50)\")\n","ax_roc.set_xlim([0.0, 1.0])\n","ax_roc.set_ylim([0.0, 1.05])\n","ax_roc.set_xlabel(\"False Positive Rate (1 - Specificity)\", fontsize=11)\n","ax_roc.set_ylabel(\"True Positive Rate (Recall / Sensitivity)\", fontsize=11)\n","ax_roc.set_title(\"Multi-Task ROC Curves\", fontsize=13, fontweight='bold', pad=10)\n","ax_roc.legend(loc=\"lower right\", frameon=True, fontsize=10)\n","ax_roc.grid(True, linestyle=\"--\", alpha=0.5)\n","\n","# -------------------------------------------------------------\n","# PLOT 3: Precision-Recall (PR) Curves\n","# -------------------------------------------------------------\n","ax_pr = plt.subplot(2, 3, 5)\n","\n","for i, (task, color) in enumerate(zip(task_names, colors)):\n","    prec_pts, rec_pts, _ = precision_recall_curve(all_targets[:, i], all_probs[:, i])\n","    ap_val = average_precision_score(all_targets[:, i], all_probs[:, i])\n","    ax_pr.plot(rec_pts, prec_pts, color=color, lw=2.2, label=f\"{task} (AP = {ap_val:.3f})\")\n","\n","ax_pr.set_xlim([0.0, 1.0])\n","ax_pr.set_ylim([0.0, 1.05])\n","ax_pr.set_xlabel(\"Recall (Sensitivity)\", fontsize=11)\n","ax_pr.set_ylabel(\"Precision (Positive Predictive Value)\", fontsize=11)\n","ax_pr.set_title(\"Precision-Recall (PR) Curves\", fontsize=13, fontweight='bold', pad=10)\n","ax_pr.legend(loc=\"upper right\", frameon=True, fontsize=10)\n","ax_pr.grid(True, linestyle=\"--\", alpha=0.5)\n","\n","# -------------------------------------------------------------\n","# PLOT 4: Comparison Bar Chart Across Diagnostic Metrics\n","# -------------------------------------------------------------\n","ax_bar = plt.subplot(2, 3, 6)\n","\n","plot_metrics = [\"Accuracy\", \"Recall\", \"Precision\", \"Specificity\", \"F1\"]\n","bar_data = []\n","\n","for i, task in enumerate(task_names):\n","    y_true = all_targets[:, i]\n","    y_prob = all_probs[:, i]\n","    y_pred = all_preds[:, i]\n","    tn, fp, fn, tp = confusion_matrix(y_true, y_pred, labels=[0, 1]).ravel()\n","\n","    bar_data.append([\n","        accuracy_score(y_true, y_pred),\n","        recall_score(y_true, y_pred, zero_division=0),\n","        precision_score(y_true, y_pred, zero_division=0),\n","        tn / (tn + fp) if (tn + fp) > 0 else 0.0,\n","        f1_score(y_true, y_pred, zero_division=0)\n","    ])\n","\n","bar_data = np.array(bar_data)  # (3, 5)\n","x = np.arange(len(plot_metrics))\n","width = 0.25\n","\n","for i, (task, color) in enumerate(zip(task_names, colors)):\n","    ax_bar.bar(x + (i - 1) * width, bar_data[i], width, label=task, color=color, alpha=0.85)\n","\n","ax_bar.set_xticks(x)\n","ax_bar.set_xticklabels(plot_metrics, fontsize=11, fontweight='bold')\n","ax_bar.set_ylim([0.0, 1.1])\n","ax_bar.set_ylabel(\"Score (0.0 to 1.0)\", fontsize=11)\n","ax_bar.set_title(\"Metric Comparison by Condition\", fontsize=13, fontweight='bold', pad=10)\n","ax_bar.legend(loc=\"lower right\", frameon=True, fontsize=10)\n","ax_bar.grid(True, linestyle=\"--\", alpha=0.5, axis='y')\n","\n","plt.tight_layout(pad=3.0)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"fp_peFSaTILz","executionInfo":{"status":"ok","timestamp":1793371997370,"user_tz":-330,"elapsed":15932,"user":{"displayName":"Shivani Patil","userId":"15851103131718099257"}},"outputId":"41257839-b1fd-448e-dbbf-9ba1fd9b1218"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["================================================================================\n","[EVALUATION] FULL CLINICAL DIAGNOSTIC METRICS & MULTI-PANEL PLOTS\n","================================================================================\n","✓ Loaded best global checkpoint from: /content/best_federated_mrnet.pth\n","\n","📋 CLINICAL PERFORMANCE SUMMARY (Validation Cohort):\n","    Condition Total (Pos/Neg) Accuracy Precision (PPV) Recall (Sens.) Specificity F1-Score ROC-AUC PR-AUC\n","     Abnormal         95 / 25   79.17%          79.17%        100.00%       0.00%   0.8837  0.6524 0.8433\n","     ACL Tear         54 / 66   55.00%           0.00%          0.00%     100.00%   0.0000  0.5568 0.5085\n","Meniscus Tear         52 / 68   56.67%           0.00%          0.00%     100.00%   0.0000  0.4713 0.4198\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1400 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":[],"metadata":{"id":"oWpB8RMdTN5n"},"execution_count":null,"outputs":[]}]}